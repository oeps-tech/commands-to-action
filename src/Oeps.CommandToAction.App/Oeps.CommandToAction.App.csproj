<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <ProjectReference Include="../Oeps.CommandToAction.Core/Oeps.CommandToAction.Core.csproj" />
    <Reference Include="Scanner.Client"><HintPath>../../client-sdk/Scanner.Client.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Scanner.Contracts"><HintPath>../../client-sdk/Scanner.Contracts.dll</HintPath><Private>true</Private></Reference>
    <EmbeddedResource Include="../../assets/app.ico" LogicalName="Oeps.AppIcon" />
    <Content Include="../../appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
